{
  "name": "civicrm/civicrm-oidc-sso",
  "description": "Provider-neutral OpenID Connect SSO and role mapping for CiviCRM",
  "type": "civicrm-ext",
  "license": "AGPL-3.0-or-later",
  "require": {
    "php": "^8.1",
    "firebase/php-jwt": "^7.2"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5",
    "squizlabs/php_codesniffer": "^3.10"
  },
  "autoload": {
    "psr-4": {
      "Civi\\OidcSso\\": "Civi/OidcSso/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Civi\\OidcSso\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "lint": "phpcs",
    "test": "phpunit",
    "check": ["@lint", "@test"]
  }
}

