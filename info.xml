<?xml version="1.0"?>
<extension key="oidc_sso" type="module">
  <file>oidc_sso</file>
  <name>OpenID Connect SSO</name>
  <description>Provider-neutral OpenID Connect single sign-on and role mapping for CiviCRM.</description>
  <license>AGPL-3.0-or-later</license>
  <maintainer>
    <author>civicrm-oidc-sso contributors</author>
    <email>civicrm-oidc-sso@whatchamacallit.xyz</email>
  </maintainer>
  <urls>
    <url desc="Main Extension Page">https://github.com/h4g3nGG/civicrm-oidc-sso</url>
    <url desc="Documentation">https://github.com/h4g3nGG/civicrm-oidc-sso/blob/main/README.md</url>
    <url desc="Support">https://github.com/h4g3nGG/civicrm-oidc-sso/issues</url>
    <url desc="Licensing">https://www.gnu.org/licenses/agpl-3.0.html</url>
  </urls>
  <releaseDate>2026-11-07</releaseDate>
  <version>0.3.0-beta.3</version>
  <develStage>beta</develStage>
  <compatibility>
    <ver>6.19</ver>
  </compatibility>
  <php_compatibility>
    <ver>8.1</ver>
    <ver>8.2</ver>
    <ver>8.3</ver>
    <ver>8.4</ver>
    <ver>8.5</ver>
  </php_compatibility>
  <classloader>
    <psr0 prefix="CRM_" path="."/>
    <psr4 prefix="Civi\\OidcSso\\" path="Civi/OidcSso"/>
    <psr4 prefix="Civi\" path="Civi"/>
  </classloader>
  <civix>
    <namespace>CRM/OidcSso</namespace>
    <format>26.10.3</format>
    <setting-page-title>OpenID Connect SSO Settings</setting-page-title>
  </civix>
  <mixins>
    <mixin>smarty@1.0.3</mixin>
    <mixin>scan-classes@1.0.0</mixin>
    <mixin>entity-types-php@2.0.0</mixin>
    <mixin>setting-php@1.0.0</mixin>
    <mixin>setting-admin@1.1.1</mixin>
  </mixins>
  <upgrader>CiviMix\Schema\OidcSso\AutomaticUpgrader</upgrader>
</extension>
