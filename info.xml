<?xml version="1.0"?>
<extension key="oidc_sso" type="module">
  <file>oidc_sso</file>
  <name>OpenID Connect SSO</name>
  <description>Provider-neutral OpenID Connect single sign-on and role mapping for CiviCRM.</description>
  <license>AGPL-3.0-or-later</license>
  <maintainer>
    <author>Contributors</author>
  </maintainer>
  <releaseDate>2026-11-06</releaseDate>
  <version>0.2.0-alpha.1</version>
  <develStage>alpha</develStage>
  <compatibility>
    <ver>6.19</ver>
  </compatibility>
  <classloader>
    <psr0 prefix="CRM_" path="."/>
    <psr4 prefix="Civi\\OidcSso\\" path="Civi/OidcSso"/>
    <psr4 prefix="Civi\" path="Civi"/>
  </classloader>
  <civix>
    <namespace>CRM/OidcSso</namespace>
    <format>26.10.3</format>
  </civix>
  <mixins>
    <mixin>smarty@1.0.3</mixin>
    <mixin>scan-classes@1.0.0</mixin>
    <mixin>entity-types-php@2.0.0</mixin>
    <mixin>setting-php@1.0.0</mixin>
  </mixins>
  <upgrader>CiviMix\Schema\OidcSso\AutomaticUpgrader</upgrader>
</extension>
