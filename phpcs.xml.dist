<?xml version="1.0"?>
<ruleset name="CiviCRM OIDC SSO">
  <description>Project coding standard.</description>
  <file>Civi</file>
  <file>tests</file>
  <exclude-pattern>tests/Integration/browser/*.js</exclude-pattern>
  <exclude-pattern>tests/Integration/browser/node_modules/*</exclude-pattern>
  <exclude-pattern>tests/AuthentikIntegration/*.js</exclude-pattern>
  <arg name="colors"/>
  <arg value="sp"/>
  <rule ref="PSR12"/>
</ruleset>

